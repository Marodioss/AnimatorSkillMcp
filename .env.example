# Optional external AI API keys (NOT required for default local/free 2D-in-3D Kounkan+ pipeline!)
# Copy this file to .env only if you want optional cloud AI video / ElevenLabs voice generation.

# Fal.ai API key (optional AI Image/Video motion workflow)
FAL_KEY=your_fal_api_key_here

# Higgsfield API key in "<id>:<secret>" format (optional Higgsfield MCP & motion tools)
HF_KEY=your_higgsfield_key_id:your_higgsfield_secret
# Or split format:
# HIGGSFIELD_API_KEY=your_higgsfield_key_id
# HIGGSFIELD_SECRET=your_higgsfield_secret

# ElevenLabs API key (optional expressive paid voice generation; default uses free Edge-TTS)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
